#!/bin/bash
# Read or set the keyboard backlight as a percentage.
#
#   omarchy-display-keyboard get          -> 0-100, or "unavailable"
#   omarchy-display-keyboard set <0-100>
#
# The stock omarchy-brightness-keyboard only steps up/down/cycle/off/restore,
# which a slider cannot drive, so this talks to brightnessctl directly.
# brightnessctl writes LEDs through logind, so no elevation is needed.

set -uo pipefail

find_device() {
  local candidate
  for candidate in /sys/class/leds/*kbd_backlight*; do
    [[ -e $candidate ]] || continue
    basename "$candidate"
    return 0
  done
  return 1
}

unavailable() {
  [[ ${action:-get} == get ]] && echo "unavailable"
  exit 0
}

action="${1:-get}"

device="$(find_device)" || unavailable

max="$(brightnessctl -d "$device" max 2>/dev/null)"
[[ $max =~ ^[0-9]+$ ]] && (( max > 0 )) || unavailable

case "$action" in
  get)
    current="$(brightnessctl -d "$device" get 2>/dev/null)"
    [[ $current =~ ^[0-9]+$ ]] || unavailable
    echo $(( current * 100 / max ))
    ;;
  set)
    percent="${2:-}"
    [[ $percent =~ ^[0-9]+$ ]] || {
      echo "Usage: $(basename "$0") set <0-100>" >&2
      exit 1
    }
    (( percent > 100 )) && percent=100
    # Round to nearest step so the low end of a coarse device still reaches 1.
    value=$(( (percent * max + 50) / 100 ))
    (( percent > 0 && value == 0 )) && value=1
    brightnessctl -d "$device" set "$value" >/dev/null || exit 1
    ;;
  *)
    echo "Usage: $(basename "$0") get|set <0-100>" >&2
    exit 1
    ;;
esac
